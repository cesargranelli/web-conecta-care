      "src/app/components/cadastro/profissional/endereco/endereco.component.ts",
      "src/app/components/cadastro/profissional/contato/contato.component.ts",
      "src/app/components/cadastro/profissional/carreira/carreira.component.ts",
      "src/app/components/cadastro/profissional/escolaridade/escolaridade.component.ts",
      "src/app/components/cadastro/profissional/experiencia/experiencia.component.ts",
      "src/app/components/cadastro/profissional/complemento/cadastro-complemento.component.ts",
      "src/app/components/cadastro/profissional/conta/cadastro-conta.component.ts"
    ]
  },

  "homecares": {
    "module": {
      "path": "src/app/homecares/homecares.module.ts",
      "standalone": false,
      "imports_extras": ["FullCalendarModule", "NgxLoadingModule"],
      "declarations_count": 34
    },
    "routing": {
      "path": "src/app/homecares/homecares-routing.module.ts",
      "guard": "authGuard",
      "routes_raiz": "homecares/:homecare_id",
