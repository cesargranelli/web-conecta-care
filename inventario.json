          { "nome": "consultarTratamentoEmAberto", "http": "GET", "url": "/tratamentos/aberto/paciente", "headers": ["pacienteId", "homeCareId"] },
          { "nome": "listarTratamentoEmAberto", "http": "GET", "url": "/tratamentos/aberto", "headers": ["homeCareId"] },
          { "nome": "encerrarTratamento", "http": "PUT", "url": "/tratamentos/encerramento" }
        ]
      },
      "atendimento_service": {
        "path": "src/app/homecares/services/atendimento.service.ts",
        "endpoint_base": "${apiConnecta}/atendimentos",
        "metodos": [
          { "nome": "consultarResumo", "http": "GET", "url": "/atendimentos/resumo", "headers": ["idHomeCare"] },
          { "nome": "consultarDetalhes", "http": "GET", "url": "/atendimentos/:id" },
          { "nome": "adicionarTratamento", "http": "POST", "url": "/atendimentos" },
          { "nome": "consultarPreview", "http": "GET", "url": "/atendimentos/preview", "headers": ["cpfProfissional", "cpfPaciente", "areaAtendimentoId", "statusAtendimentoId", "homeCareId", "periodoDe", "periodoAte"] },
          { "nome": "downloadFile", "http": "GET", "url": "/atendimentos/preview/file", "responseType": "blob" }
        ]
      },
      "paciente_service": { "path": "src/app/homecares/services/paciente.service.ts" },
      "contato_service": { "path": "src/app/homecares/services/contato.service.ts" },
      "endereco_service": { "path": "src/app/homecares/services/endereco.service.ts" },
      "tratamento_storage_service": { "path": "src/app/homecares/services/tratamento-storage.service.ts", "descricao": "Estado local de tratamento em criação" }
    },
    "classes_count": 30,
    "classes_path": "src/app/homecares/classes/"
  },

