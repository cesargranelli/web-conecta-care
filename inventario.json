{
  "meta": {
    "projeto": "web-conecta-care",
    "framework": "Angular 9 (bootstrap) + Angular 17+ standalone/signals",
    "gerado_em": "2026-06-04",
    "total_arquivos_ts": 350,
    "modulos_lazy": ["admin", "pacientes", "profissionais", "homecares", "planos-saude", "planos-saude-filial"],
    "arquitetura": "Standalone bootstrap (main.ts -> bootstrapApplication), módulos NgModule para features legadas",
    "interceptors": ["tokenInterceptor", "headersInterceptor", "sizeBodyInterceptor"],
    "guard": "authGuard (CanActivateFn)",
    "ui_libs": ["PrimeNG (Aura theme)", "ngx-mask", "sweetalert2", "ng-recaptcha-2", "FullCalendar", "ngx-loading"],
    "environment_vars": ["environment.apiConnecta", "environment.apiCep"]
  },

  "core": {
    "bootstrap": {
      "path": "src/main.ts",
      "description": "bootstrapApplication(AppComponent, appConfig)"
    },
    "app_component": {
      "path": "src/app/app.component.ts",
      "selector": "app-root",
      "standalone": true,
      "imports": ["RouterOutlet", "NavbarComponent", "FooterComponent"],
      "description": "Shell raiz; gerencia loading global e expõe activeValid para o template"
    },
    "app_config": {
      "path": "src/app/app.config.ts",
      "providers": [
        "provideZoneChangeDetection",
        "provideRouter(APP_ROUTES, withComponentInputBinding, withRouterConfig(paramsInheritanceStrategy:always))",
        "provideHttpClient(withInterceptors([tokenInterceptor, headersInterceptor, sizeBodyInterceptor]))",
        "provideAnimationsAsync",
        "providePrimeNG (Aura theme, darkModeSelector:false)",
        "provideNgxMask"
      ]
    },
    "app_routes": {
      "path": "src/app/app.routes.ts",
      "routes": [
        { "path": "", "redirectTo": "login" },
        { "path": "login", "component": "LoginComponent" },
        { "path": "login/manutencao-senha", "component": "ManutencaoSenhaComponent" },
        { "path": "login/esqueci-minha-senha", "component": "EsqueciMinhaSenhaComponent" },
        { "path": "login/nova-senha/:id", "component": "NovaSenhaComponent" },
        { "path": "admin/login", "component": "LoginAdminComponent" },
        { "path": "cadastro", "component": "RegisterComponent" },
        { "path": "cadastro/profissionais/:id", "guard": "authGuard", "lazy": "CADASTRO_PROFISSIONAL_ROUTES" },
        { "path": "confirmacao-nova-senha/:token", "lazy": "ConfirmacaoNovaSenhaComponent" },
        { "path": "espera-confirmacao-email", "lazy": "EsperaConfirmacaoEmailComponent" },
        { "path": "termo-e-condicoes-de-uso", "lazy": "TermoUsoComponent" },
        { "path": "politica-de-privacidade", "lazy": "TermoPrivacidadeComponent" },
        { "path": "confirmacao-cadastro/:token", "lazy": "ConfirmacaoCadastroComponent" },
        { "path": "pacientes", "guard": "authGuard", "lazy": "PacientesModule" },
        { "path": "profissionais", "guard": "authGuard", "lazy": "ProfissionaisModule" },
        { "path": "homecares", "guard": "authGuard", "lazy": "HomeCaresModule" },
        { "path": "planos-saude", "guard": "authGuard", "lazy": "PlanosSaudeModule" },
        { "path": "planos-saude-filial", "guard": "authGuard", "lazy": "PlanosSaudeFilialModule" },
        { "path": "admin", "lazy": "AdminModule" },
        { "path": "**", "redirectTo": "login" }
      ]
    }
  },

  "auth": {
    "routes": {
      "path": "src/app/auth/auth.routes.ts",
      "file": "AUTH_ROUTES",
      "entries": [
        { "path": "", "component": "LoginComponent" },
        { "path": "login", "component": "LoginComponent" },
        { "path": "login/manutencao-senha", "component": "ManutencaoSenhaComponent" },
        { "path": "login/esqueci-minha-senha", "component": "EsqueciMinhaSenhaComponent" },
        { "path": "login/nova-senha/:id", "component": "NovaSenhaComponent" },
        { "path": "admin/login", "component": "LoginAdminComponent" }
      ]
    },
    "guards": {
      "auth_guard": {
        "path": "src/app/auth/guards/auth.guard.ts",
        "type": "CanActivateFn",
        "logica": "Verifica SharedTokenService.isLoggedIn(); se falso redireciona para /login"
      }
    },
    "interceptors": {
      "token_interceptor": {
        "path": "src/app/auth/interceptors/token.interceptor.ts",
        "logica": "Injeta header Authorization: Bearer <token> em requisições para environment.apiConnecta; trata HttpErrorResponse"
      },
      "headers_interceptor": {
        "path": "src/app/auth/interceptors/headers.interceptor.ts",
        "logica": "Adiciona Content-Type: application/json a todas as requisições"
      },
      "size_body_interceptor": {
        "path": "src/app/auth/interceptors/size-body.interceptor.ts",
        "logica": "Calcula e loga no console o tamanho do body da requisição (bytes/KiB/MiB); sem bloqueio"
      }
    },
    "services": {
      "auth_service": {
        "path": "src/app/auth/services/auth.service.ts",
        "providedIn": "root",
        "endpoint_base": "${apiConnecta}",
        "metodos": [
          { "nome": "login", "http": "POST", "url": "/login", "descricao": "Autentica usuário; armazena token via SharedTokenService" },
          { "nome": "storeTokens", "http": null, "descricao": "Chama SharedTokenService.setToken" },
          { "nome": "removeTokens", "http": null, "descricao": "Remove token e valid do localStorage" }
        ]
      },
      "auth_admin_service": {
        "path": "src/app/auth/services/auth-admin.service.ts",
        "providedIn": "root",
        "endpoint_base": "${apiConnecta}",
        "metodos": [
          { "nome": "login", "http": "POST", "url": "/admin/login", "descricao": "Autentica admin; armazena token e valid" },
          { "nome": "storeTokens", "http": null, "descricao": "Persiste token + valid (com role convertida)" },
          { "nome": "removeTokens", "http": null }
        ]
      },
      "login_service": {
        "path": "src/app/auth/services/login.service.ts",
        "note": "Duplicata de src/app/services/login.service.ts",
        "providedIn": "root",
        "endpoint_base": "${apiConnecta}/login",
        "metodos": [
          { "nome": "verLogin", "http": "GET", "url": "/login" },
          { "nome": "esqueciMinhaSenha", "http": "POST", "url": "/login/esqueci-minha-senha" },
          { "nome": "validaToken", "http": "POST", "url": "/login/validacao" },
          { "nome": "novaSenha", "http": "PATCH", "url": "/login/nova-senha" },
          { "nome": "buscarValid", "http": "POST", "url": "/login/valid" }
        ]
      }
    },
    "components": {
      "login": {
        "path": "src/app/auth/containers/login/login.component.ts",
        "selector": "app-login",
        "standalone": true,
        "imports": ["CommonModule", "ReactiveFormsModule", "RouterModule"],
        "descricao": "Login principal; seleciona módulo (pacientes/profissionais/etc); usa AuthService + UsuarioService"
      },
      "login_admin": {
        "path": "src/app/auth/containers/login-admin/login-admin.component.ts",
        "selector": "app-login-admin",
        "standalone": true,
        "imports": ["CommonModule", "ReactiveFormsModule", "RouterModule"],
        "descricao": "Login exclusivo para admin; usa AuthAdminService; navega para admin/eventos"
      },
      "esqueci_minha_senha": {
        "path": "src/app/auth/containers/login/esqueci-minha-senha/esqueci-minha-senha.component.ts",
        "standalone": "unknown (não lido)"
      },
      "manutencao_senha": {
        "path": "src/app/auth/containers/login/manutencao-senha/manutencao-senha.component.ts",
        "standalone": "unknown (não lido)"
      },
      "nova_senha": {
        "path": "src/app/auth/containers/login/nova-senha/nova-senha.component.ts",
        "standalone": "unknown (não lido)"
      }
    }
  },

  "admin": {
    "module": {
      "path": "src/app/admin/admin.module.ts",
      "standalone": false,
      "declarations": ["EventosComponent", "EventoCadastroComponent", "EventoDetalheComponent"],
      "imports": ["CommonModule", "ReactiveFormsModule", "AdminRoutingModule", "NgxMaskDirective", "NgxMaskPipe"]
    },
    "routing": {
      "path": "src/app/admin/admin-routing.module.ts",
      "routes": [
        { "path": "admin", "redirectTo": "admin/login" },
        { "path": "admin/eventos", "component": "EventosComponent" },
        { "path": "admin/eventos/cadastro", "component": "EventoCadastroComponent" },
        { "path": "admin/eventos/:id", "component": "EventoDetalheComponent" }
      ]
    },
    "components": {
      "eventos": {
        "path": "src/app/admin/eventos/eventos.component.ts",
        "standalone": false
      },
      "evento_cadastro": {
        "path": "src/app/admin/eventos/cadastro/evento-cadastro.component.ts",
        "standalone": false
      },
      "evento_detalhe": {
        "path": "src/app/admin/eventos/detalhe/evento-detalhe.component.ts",
        "standalone": false
      }
    },
    "models": [
      "src/app/admin/models/login-admin.model.ts",
      "src/app/admin/models/token-admin.model.ts",
      "src/app/admin/eventos/models/evento.class.ts"
    ]
  },

  "pacientes": {
    "module": {
      "path": "src/app/pacientes/pacientes.module.ts",
      "standalone": false,
      "declarations": [
        "PacientesComponent", "CadastroInformacoesGeraisComponent", "CadastroEnderecoComponent",
        "CadastroContatoComponent", "CadastroComplementoComponent", "CadastroHistoricoMedicoComponent",
        "FormContatoComponent", "DadosComponent", "ComplementoComponent", "ContatoComponent",
        "EnderecoComponent", "HistoricoMedicoComponent", "InformacoesGeraisComponent",
        "LoginComponent", "FormInformacoesGeraisComponent", "FormHistoricoMedicoComponent",
        "FormComplementoComponent", "FormEnderecoComponent", "CardVerDadosComponent",
        "QrcodeComponent", "PrettyStringPipe", "CadastroDependenteCpfComponent"
      ],
      "imports": ["CommonModule", "PacientesRoutingModule", "FormsModule", "ReactiveFormsModule", "NgxMaskDirective", "NgxMaskPipe"]
    },
    "routing": {
      "path": "src/app/pacientes/pacientes-routing.module.ts",
      "guard": "authGuard",
      "routes_raiz": "pacientes/:paciente_id",
      "sub_routes": [
        "pacientes/cadastro-dependente-cpf",
        "pacientes/:id (PacientesComponent)",
        "pacientes/:id/cadastro/informacoes-gerais",
        "pacientes/:id/cadastro/endereco",
        "pacientes/:id/cadastro/contato",
        "pacientes/:id/cadastro/complemento",
        "pacientes/:id/cadastro/historico-medico",
        "pacientes/:id/dados (DadosComponent)",
        "pacientes/:id/dados/login",
        "pacientes/:id/dados/informacoes-gerais",
        "pacientes/:id/dados/endereco",
        "pacientes/:id/dados/contato",
        "pacientes/:id/dados/complemento",
        "pacientes/:id/dados/historico-medico"
      ]
    },
    "services": {
      "paciente_service": {
        "path": "src/app/pacientes/services/paciente.service.ts",
        "endpoint_base": "${apiConnecta}/api/v1/paciente",
        "metodos": [
          { "nome": "registrar", "http": "POST", "url": "/api/v1/paciente" },
          { "nome": "alterar", "http": "PUT", "url": "/api/v1/paciente" },
          { "nome": "pesquisarPorCpf", "http": "GET", "url": "/api/v1/paciente?documento=" },
          { "nome": "pesquisarPorId", "http": "GET", "url": "/api/v1/paciente/:id" }
        ]
      },
      "atendimento_service": { "path": "src/app/pacientes/services/atendimento.service.ts" },
      "contato_service": { "path": "src/app/pacientes/services/contato.service.ts" },
      "endereco_service": { "path": "src/app/pacientes/services/endereco.service.ts" },
      "estado_civil_service": { "path": "src/app/pacientes/services/estado-civil.service.ts" },
      "estado_service": { "path": "src/app/pacientes/services/estado.service.ts" },
      "genero_service": { "path": "src/app/pacientes/services/genero.service.ts" },
      "historico_medico_service": { "path": "src/app/pacientes/services/historico-medico.service.ts" },
      "tipo_sanguineo_service": { "path": "src/app/pacientes/services/tipo-sanguineo.service.ts" },
      "dados_responsavel_dependente": { "path": "src/app/pacientes/shared/services/dados-responsavel-dependente.service.ts" }
    },
    "classes": [
      "acompanhante.class.ts", "atendimento-protocolo.class.ts", "contato-paciente.class.ts",
      "endereco-paciente.class.ts", "historico-medico-paciente.class.ts", "paciente.class.ts",
      "parentesco.class.ts", "protocolo.class.ts", "responsavel.class.ts",
      "tipo-paciente.class.ts", "tipo-sanguineo-paciente.class.ts"
    ]
  },

  "profissionais": {
