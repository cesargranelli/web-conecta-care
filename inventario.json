        "homecares/:id/prontuario/:prontuario_id",
        "homecares/:id/tratamento/solicitacao",
        "homecares/:id/tratamento/preview",
        "homecares/:id/tratamento/em-andamento",
        "homecares/:id/tratamento/em-andamento/:tratamento_id",
        "homecares/:id/tratamento/em-andamento/:tratamento_id/novo-atendimento",
        "homecares/:id/profissional",
        "homecares/:id/paciente",
        "homecares/:id/paciente/:paciente_id (dados completos do paciente reusados)"
      ]
    },
    "services": {
